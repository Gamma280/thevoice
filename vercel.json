{
  "cleanUrls": true,
  "functions": {
    "api/index.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/collect",
      "schedule": "0 6 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/.well-known/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/oauth/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/mcp",
      "destination": "/api/index"
    },
    {
      "source": "/health",
      "destination": "/api/index"
    }
  ]
}
