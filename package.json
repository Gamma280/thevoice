{
  "name": "thevoice",
  "version": "0.1.0",
  "description": "MCP-powered memory and canvas for solo founders",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:init": "node -e \"require('dotenv').config({quiet:true});require('./database').init().then(()=>{console.log('db ready');process.exit(0)})\"",
    "mcp:stdio": "node mcp-server.js",
    "test": "node --test \"test/*.test.js\"",
    "collect": "node scripts/collect.js",
    "mcp:check": "node scripts/mcp-check.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "jsdom": "^31.0.0"
  }
}
