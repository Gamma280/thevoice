TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=
PORT=3000
BASE_URL=

# Collection
CRON_SECRET=change-me-to-a-long-random-string   # Bearer secret for /api/cron/collect (Vercel Cron sends it automatically)
COLLECT_BUDGET_MS=240000                        # max time a cron run may spend starting new sources

# Reddit today: Arctic Shift (primary) -> Reddit RSS (fallback). No credentials needed.
# The official API below is a PLACEHOLDER for later: leave these blank until Reddit approves your app; once all three are set it is used first.
# Real values go ONLY in your local .env (git-ignored) and Vercel env vars. REDDIT_PROVIDER=off disables Reddit entirely.
REDDIT_PROVIDER=auto                            # auto | official | arctic | rss | off
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
